# OpenAI API
OPENAI_API_KEY=sk-your_openai_api_key_here

# Qdrant Vector Database
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here

# Tavily Search API (for web search integration)
# Get your API key from https://tavily.com
# Free tier includes 1000 searches/month
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Set to "true" for certification demo mode
CERTIFICATION_DEMO=false

# Note: These environment variables should be added to your frontend/.env.local file